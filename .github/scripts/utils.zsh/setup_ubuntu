autoload -Uz log_error log_status log_info mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

typeset -g QT_VERSION

# Ubuntu 26.04 can be configured for the amd64v3 architecture variant, which makes apt read only the
# binary-amd64v3 indexes. The obsproject PPA publishes plain amd64 builds only, so without this apt
# silently falls back to the older distribution obs-studio package that lacks the libobs CMake files.
local -a apt_variant_args=(-o APT::Architecture-Variants=amd64)

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
  ${apt_variant_args}
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  local suffix
  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    local -A arch_mappings=(
      aarch64 arm64
      x86_64 amd64
    )

    suffix=":${arch_mappings[${target##*-}]}"

    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  sudo add-apt-repository --yes ppa:obsproject/obs-studio
  sudo apt-get ${apt_variant_args} update

  # The distribution's own obs-studio package ships no development files, so the build needs the PPA's. On systems
  # where apt uses an architecture variant (Ubuntu 26.04 runners use amd64v3) apt only reads the PPA's variant
  # index, which is empty, and silently falls back to the distribution package. Fetch the PPA build directly then.
  local obs_package=obs-studio
  if ! apt-cache madison obs-studio | grep -q 'launchpadcontent.net/obsproject/obs-studio'; then
    local ppa_url='https://ppa.launchpadcontent.net/obsproject/obs-studio/ubuntu'
    local deb_arch=${${${target##*-}/x86_64/amd64}/aarch64/arm64}
    local codename=$(. /etc/os-release && print -r -- ${VERSION_CODENAME})
    local deb_file deb_hash
    read -r deb_file deb_hash <<< "$(curl -fsSL ${ppa_url}/dists/${codename}/main/binary-${deb_arch}/Packages.gz \
      | gunzip \
      | awk -v RS= '/(^|\n)Package: obs-studio\n/ {
          n = split($0, lines, "\n")
          for (i = 1; i <= n; i++) {
            if (lines[i] ~ /^Filename: /) file = substr(lines[i], 11)
            if (lines[i] ~ /^SHA256: /) hash = substr(lines[i], 9)
          }
          print file, hash
          exit
        }')"

    if [[ -z ${deb_file} || -z ${deb_hash} ]] {
      log_error "No obs-studio package for ${codename}/${deb_arch} in the OBS PPA."
      return 2
    }

    log_info "apt does not see the OBS PPA build, downloading ${deb_file:t}"
    mkdir -p ${project_root}/.deps
    curl -fsSL -o ${project_root}/.deps/obs-studio.deb ${ppa_url}/${deb_file}
    print -r -- "${deb_hash}  ${project_root}/.deps/obs-studio.deb" | sha256sum --check --status || {
      log_error "Checksum of downloaded ${deb_file:t} does not match the PPA index."
      return 2
    }
    obs_package=${project_root}/.deps/obs-studio.deb
  fi

  sudo apt-get install ${apt_args} \
    build-essential \
    libgles2-mesa-dev \
    libsimde-dev \
    libavcodec-dev \
    libavutil-dev \
    libssl-dev \
    libgtest-dev \
    nlohmann-json3-dev \
    ${obs_package}

  local -a _qt_packages=()

  if (( QT_VERSION == 5 )) {
    _qt_packages+=(
      qtbase5-dev${suffix}
      libqt5svg5-dev${suffix}
      qtbase5-private-dev${suffix}
      libqt5x11extras5-dev${suffix}
    )
  } else {
    _qt_packages+=(
      qt6-base-dev${suffix}
      libqt6svg6-dev${suffix}
      qt6-base-private-dev${suffix}
    )
  }

  sudo apt-get install ${apt_args} ${_qt_packages}
  log_group
}
